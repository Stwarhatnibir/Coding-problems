class Leetcode1872 {

    public static void main(String[] args) {

        Solution solution = new Solution();

        int[] stones = {-1, 2, -3, 4, -5};

        int result = solution.stoneGameVIII(stones);

        System.out.println("Maximum score difference = " + result);
    }
}

class Solution {

    public int stoneGameVIII(int[] stones) {

        int n = stones.length;

        // Create prefix sum
        for (int i = 1; i < n; i++) {
            stones[i] += stones[i - 1];
        }

        // Start from the last possible move
        int best = stones[n - 1];

        for (int i = n - 2; i >= 1; i--) {

            best = Math.max(
                best,
                stones[i] - best
            );
        }

        return best;
    }
}